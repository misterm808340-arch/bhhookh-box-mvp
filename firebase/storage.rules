rules_version = '2';

// ============================================================================
// BHHOOKH BOX — Firebase Storage Rules (product images)
// ============================================================================
// Product images live under products/{fileName}.
//   - READ: public (the customer app renders product images directly).
//   - WRITE/DELETE: backend-verified admins only. Storage rules cannot query
//     Firestore, so admin authorisation here relies on the `admin: true`
//     custom claim set by the bootstrap script (see scripts/bootstrap-admin.mjs
//     in the repo root / SETUP docs). Run it once per admin account.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
