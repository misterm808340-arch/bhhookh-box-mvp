# BHHOOKH BOX customer app — configuration
# Copy this file to `.env` and fill in the values from your Firebase project:
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
#
# IMPORTANT: use the SAME Firebase project as the admin dashboard.
# (The web app config works for the Android app too — this MVP uses the
# Firebase JS SDK, so google-services.json is NOT required.)

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Trusted backend (Spark-plan edition) — the Vercel deployment of the admin
# dashboard hosts the ordering API. Example: https://bhhookh-box.vercel.app
# Orders are placed ONLY through this API; it validates every price server-side.
EXPO_PUBLIC_API_BASE_URL=https://your-backend.vercel.app
