{
  "expo": {
    "name": "BHHOOKH BOX",
    "slug": "bhhookh-box",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3F7963"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhhookhbox.app"
    },
    "android": {
      "package": "com.bhhookhbox.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3F7963"
      },
      "edgeToEdgeEnabled": true
    }
  }
}
