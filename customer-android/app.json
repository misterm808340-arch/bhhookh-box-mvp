{
  "expo": {
    "name": "BHHOOKH BOX",
    "slug": "bhhookh-box",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3F7963"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhhookhbox.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BHHOOKH BOX uses your location to share your live position with customers while you deliver their order."
      }
    },
    "android": {
      "package": "com.bhhookhbox.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3F7963"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BHHOOKH BOX uses your location to share your live position with customers while you deliver their order."
        }
      ]
    ]
  }
}
