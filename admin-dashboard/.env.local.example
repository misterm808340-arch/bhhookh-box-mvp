# Firebase web configuration — BHHOOKH BOX Admin Dashboard
# Copy this file to `.env.local` and fill in values from:
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup
#
# Use the SAME values as the customer app's .env — one project, one Firestore.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
