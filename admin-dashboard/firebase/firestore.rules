rules_version = '2';

// ============================================================================
// BHHOOKH BOX — Firestore Security Rules
// ============================================================================
// Data model
//   orders/{orderId}      — created by the CUSTOMER app (no auth required),
//                           read/updated only by authorized ADMINS.
//   categories/{id}       — menu categories. Public read (customers render
//                           enabled ones), admin-only write.
//   products/{id}         — menu products, every product carries categoryId.
//                           Public read (customers render available ones),
//                           admin-only write.
//   admins/{email}        — whitelist, managed via the Firebase Console only.
//
// Admin authorization: a signed-in user is an admin iff a document exists in
// the `admins` collection whose document ID equals their auth email exactly.
//
// Order status workflow enforced on update (mirrors the admin dashboard):
//   Pending → Accepted → Preparing → Out for Delivery → Delivered
//   Pending → Rejected   (reject option)
//
// Price validation: products (and therefore prices) can only be written by
// admins. The customer app re-reads each product at checkout and rebuilds the
// order payload from the FRESH Firestore price + availability before creating
// the order (see customer src/lib/orders.ts → placeOrder). Full per-item
// price re-checks inside the write path require a Cloud Function (Blaze plan).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helper functions ─────────────────────────

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isSupportedStatus(status) {
      return status in ['Pending', 'Accepted', 'Preparing', 'Out for Delivery', 'Delivered', 'Rejected'];
    }

    function validUrlOrNull(value) {
      return value is string && value.matches('^https://[^ ]{1,1000}$');
    }

    /**
     * Order documents created by the customer app.
     * NOTE: Firestore rules cannot iterate list elements, so per-item prices
     * cannot be verified here — that is handled by the app re-reading fresh
     * product data at checkout and (optionally, later) a Cloud Function.
     */
    function isValidOrderCreation(d) {
      return d.keys().hasAll(['orderId', 'customer', 'items', 'subtotal', 'deliveryFee', 'total', 'paymentMethod', 'status', 'createdAt'])
        && d.keys().hasOnly(['orderId', 'customer', 'items', 'subtotal', 'deliveryFee', 'total', 'paymentMethod', 'status', 'createdAt'])

        && d.orderId is string
        && d.orderId.matches('^BHB-[A-Z0-9-]{4,24}$')

        && d.customer is map
        && d.customer.keys().hasAll(['name', 'phone', 'address'])
        && d.customer.keys().hasOnly(['name', 'phone', 'address'])
        && d.customer.name is string
        && d.customer.name.size() >= 2 && d.customer.name.size() <= 80
        && d.customer.phone is string
        && d.customer.phone.matches('^\\d{10}$')
        && d.customer.address is string
        && d.customer.address.size() >= 10 && d.customer.address.size() <= 500

        && d.items is list
        && d.items.size() >= 1 && d.items.size() <= 50

        && d.subtotal is number && d.subtotal > 0 && d.subtotal <= 100000
        && d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 500
        && d.total is number && d.total == d.subtotal + d.deliveryFee

        && d.paymentMethod == 'COD'
        && d.status == 'Pending'
        && d.createdAt == request.time;
    }

    /**
     * Admin status updates may ONLY change `status` + `updatedAt`, and only
     * along the allowed workflow. Fixes a mis-clicked Reject requires a new
     * order (or a temporary rule change by the project owner).
     */
    function isValidStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && isSupportedStatus(request.resource.data.status)
        && (
          (resource.data.status == 'Pending' && request.resource.data.status == 'Accepted')
          || (resource.data.status == 'Pending' && request.resource.data.status == 'Rejected')
          || (resource.data.status == 'Accepted' && request.resource.data.status == 'Preparing')
          || (resource.data.status == 'Preparing' && request.resource.data.status == 'Out for Delivery')
          || (resource.data.status == 'Out for Delivery' && request.resource.data.status == 'Delivered')
        );
    }

    // ─────────────────────── Catalogue validation ───────────────────────

    function isValidCategoryWrite(d, isNew) {
      return d.keys().hasAll(['name', 'icon', 'enabled', 'sortOrder', 'updatedAt'])
        && d.keys().hasOnly(['name', 'icon', 'emoji', 'imageUrl', 'enabled', 'sortOrder', 'createdAt', 'updatedAt'])

        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.icon is string && d.icon.size() >= 1 && d.icon.size() <= 40
        && d.enabled is bool
        && d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 9999

        && (!d.keys().hasAny(['emoji']) || (d.emoji is string && d.emoji.size() <= 8))
        && (!d.keys().hasAny(['imageUrl']) || validUrlOrNull(d.imageUrl))

        && d.updatedAt == request.time
        && (isNew ? d.createdAt == request.time : d.createdAt == resource.data.createdAt);
    }

    function isValidProductWrite(d, isNew) {
      return d.keys().hasAll(['name', 'description', 'categoryId', 'price', 'isVeg', 'popular', 'available', 'sortOrder', 'updatedAt'])
        && d.keys().hasOnly(['name', 'description', 'categoryId', 'categoryName', 'price', 'mrp', 'imageUrl', 'isVeg', 'popular', 'available', 'sortOrder', 'rating', 'prepTime', 'createdAt', 'updatedAt'])

        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.description is string && d.description.size() <= 500
        && d.categoryId is string && d.categoryId.matches('^[a-zA-Z0-9_-]{1,60}$')
        && d.price is number && d.price >= 1 && d.price <= 100000
        && d.price is int
        && d.isVeg is bool && d.popular is bool && d.available is bool
        && d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 9999

        && (!d.keys().hasAny(['categoryName']) || (d.categoryName is string && d.categoryName.size() <= 40))
        && (!d.keys().hasAny(['mrp']) || (d.mrp is number && d.mrp >= d.price && d.mrp <= 200000))
        && (!d.keys().hasAny(['imageUrl']) || validUrlOrNull(d.imageUrl))
        && (!d.keys().hasAny(['rating']) || (d.rating is number && d.rating >= 0 && d.rating <= 5))
        && (!d.keys().hasAny(['prepTime']) || (d.prepTime is string && d.prepTime.size() <= 24))

        && d.updatedAt == request.time
        && (isNew ? d.createdAt == request.time : d.createdAt == resource.data.createdAt);
    }

    // ─────────────────────────── Collections ────────────────────────────

    match /orders/{orderId} {
      // Only whitelisted admins can read incoming orders.
      allow get, list: if isAdmin();
      // Anyone (the customer app) may create an order — if it is well-formed.
      allow create: if request.resource.data.orderId == orderId
        && isValidOrderCreation(request.resource.data);
      // Only admins may change status, only along the workflow above.
      allow update: if isAdmin() && isValidStatusUpdate();
      // Cleanup / refunds handled by admins.
      allow delete: if isAdmin();
    }

    // Menu categories — public read (the app queries enabled ones),
    // admin-only modifications.
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidCategoryWrite(request.resource.data, true);
      allow update: if isAdmin() && isValidCategoryWrite(request.resource.data, false);
      allow delete: if isAdmin();
    }

    // Menu products — public read (the app queries available ones),
    // admin-only modifications. Every product must carry a categoryId.
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() >= 1
        && isValidProductWrite(request.resource.data, true);
      allow update: if isAdmin() && isValidProductWrite(request.resource.data, false);
      allow delete: if isAdmin();
    }

    // Admin whitelist — managed in the Firebase Console, never writable from clients.
    // A user can only check whether THEIR OWN email is whitelisted.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list: if false;
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
