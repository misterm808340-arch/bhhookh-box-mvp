rules_version = '2';

// ============================================================================
// BHHOOKH BOX — Firestore Security Rules v2 (Email/Password upgrade)
// ============================================================================
// Collections
//   users/{uid}            customer profiles (owner read/write)
//   addresses/{docId}      saved delivery addresses (owner read/write)
//   orders/{orderId}       WRITTEN ONLY by the `createOrder` Cloud Function.
//                          Customers read their own; admins read all; drivers
//                          may update ONLY `driverLocation` on assigned orders.
//   categories/{id}        menu categories — public read, admin write
//   products/{id}          menu products — public read, admin write
//   admins/{email}         admin whitelist (Console-managed, read own only)
//   drivers/{uid}          driver roster (Cloud-Function-managed)
//   settings/app           app settings (delivery fee) — public read
//
// Admin authorisation is verified SERVER-SIDE:
//   request.auth.token.admin == true  (custom claim set by the bootstrap
//                                      script / Cloud Functions)
//   OR a document in `admins/{email}` matching the auth email exactly.
// The client-facing dashboard may *display* admin UI, but every write is
// re-checked here and in Cloud Functions — client state is never trusted.
//
// Order status workflow (enforced by Cloud Functions, not writable by clients):
//   Order Placed → Accepted → Preparing → Out for Delivery → Delivered
//   Order Placed → Rejected | Cancelled (customer, before kitchen starts)
//   Accepted/Preparing → Cancelled
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helper functions ─────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.toLowerCase()
        : '';
    }

    // Backend-verified admin: custom claim OR admins whitelist document.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || (request.auth.token.email != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.toLowerCase())))
      );
    }

    // Backend-verified active driver: claim OR active drivers/{uid} document.
    function isDriver() {
      return isSignedIn() && (
        request.auth.token.driver == true
        || (exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
            && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.active == true)
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUrlOrNull(value) {
      return value is string && value.matches('^https://[^ ]{1,1000}$');
    }

    // ──────────────────────────── users/{uid} ────────────────────────────

    match /users/{uid} {
      // Profile documents are private to the customer. Admins may read for
      // support (order screens show the embedded customer info instead).
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false; // no client-side directory browsing, ever
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 15))
        && request.resource.data.role == 'customer';
      allow delete: if false;
    }

    // ────────────────────────── addresses/{docId} ─────────────────────────

    match /addresses/{addressId} {
      // Saved delivery addresses — strictly private to their owner.
      // Document must carry the owner's uid; the id itself is opaque.
      function ownedByCaller() {
        return isSignedIn()
          && resource.data.uid == request.auth.uid;
      }
      allow get, list: if ownedByCaller();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 1
        && request.resource.data.label.size() <= 40
        && request.resource.data.receiverName is string
        && request.resource.data.receiverName.size() >= 2
        && request.resource.data.receiverName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\d{10}$')
        && request.resource.data.line is string
        && request.resource.data.line.size() >= 10
        && request.resource.data.line.size() <= 500;
      allow update: if ownedByCaller()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.receiverName is string
        && request.resource.data.receiverName.size() >= 2
        && request.resource.data.receiverName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\d{10}$')
        && request.resource.data.line is string
        && request.resource.data.line.size() >= 10
        && request.resource.data.line.size() <= 500;
      allow delete: if ownedByCaller();
    }

    // ─────────────────────────── orders/{orderId} ──────────────────────────

    match /orders/{orderId} {
      // Customers see ONLY their own orders; drivers see ONLY orders assigned
      // to them; admins see all. For `list` the rules engine verifies that the
      // QUERY itself is constrained to documents matching the same condition.
      allow get: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isDriver() && resource.data.driverId == request.auth.uid)
        || isAdmin();

      // Orders are created ONLY by the `createOrder` Cloud Function, which
      // uses the Admin SDK and bypasses these rules. Clients are denied so
      // no forged price/total/status can ever reach the database.
      allow create: if false;

      // Drivers may ONLY refresh their live GPS position on an order that is
      // assigned to them and currently out for delivery. Nothing else.
      allow update: if isDriver()
        && resource.data.driverId == request.auth.uid
        && resource.data.status in ['Out for Delivery', 'Preparing']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverLocation'])
        && request.resource.data.driverLocation.keys().hasAll(['lat', 'lng', 'updatedAt'])
        && request.resource.data.driverLocation.lat is number
        && request.resource.data.driverLocation.lat >= -90 && request.resource.data.driverLocation.lat <= 90
        && request.resource.data.driverLocation.lng is number
        && request.resource.data.driverLocation.lng >= -180 && request.resource.data.driverLocation.lng <= 180;

      // Cleanup only via Cloud Functions / Console (Admin SDK bypasses rules).
      allow delete: if false;
    }

    // ───────────────────────── categories/{categoryId} ─────────────────────

    match /categories/{categoryId} {
      allow get, list: if true; // customer menu needs enabled categories
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.icon is string && request.resource.data.icon.size() >= 1 && request.resource.data.icon.size() <= 40
        && request.resource.data.enabled is bool
        && request.resource.data.sortOrder is int
        && (!('emoji' in request.resource.data) || (request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8))
        && (!('imageUrl' in request.resource.data) || validUrlOrNull(request.resource.data.imageUrl));
      allow update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }

    // ────────────────────────── products/{productId} ───────────────────────

    match /products/{productId} {
      allow get, list: if true; // customer menu needs available products

      // Admin-only writes. The offer model:
      //   mrp          original price (must be >= selling price)
      //   price        selling price inside the offer window
      //   offerEnabled offer window on/off
      //   offerStart   optional start boundary (Timestamp or null)
      //   offerEnd     optional end boundary (Timestamp or null)
      // Effective pricing is re-computed server-side at order time.
      function validProduct(d, isNew) {
        return d.name is string && d.name.size() >= 2 && d.name.size() <= 120
          && d.description is string && d.description.size() <= 500
          && d.categoryId is string && d.categoryId.matches('^[a-zA-Z0-9_-]{1,60}$')
          && d.price is number && d.price is int && d.price >= 1 && d.price <= 100000
          && (!('mrp' in d) || d.mrp == null || (d.mrp is number && d.mrp is int && d.mrp >= d.price && d.mrp <= 200000))
          && d.offerEnabled is bool
          && (!('offerStart' in d) || d.offerStart == null || d.offerStart is timestamp)
          && (!('offerEnd' in d) || d.offerEnd == null || d.offerEnd is timestamp)
          && (!('stock' in d) || d.stock == null || (d.stock is int && d.stock >= 0 && d.stock <= 10000))
          && d.available is bool
          && d.isVeg is bool && d.popular is bool
          && (!('discountPercent' in d) || (d.discountPercent is int && d.discountPercent >= 0 && d.discountPercent <= 99))
          && (!('imageUrl' in d) || validUrlOrNull(d.imageUrl))
          && (!('categoryName' in d) || (d.categoryName is string && d.categoryName.size() <= 40))
          && (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5))
          && (!('prepTime' in d) || (d.prepTime is string && d.prepTime.size() <= 24))
          && (isNew ? true : d.createdAt == resource.data.createdAt);
      }

      allow create: if isAdmin() && validProduct(request.resource.data, true);
      allow update: if isAdmin() && validProduct(request.resource.data, false);
      allow delete: if isAdmin();
    }

    // ─────────────────────────── admins/{email} ────────────────────────────

    match /admins/{email} {
      // Whitelist documents: Console-managed. A user may only check whether
      // THEIR OWN email is whitelisted; listing is always denied.
      allow get: if isSignedIn() && callerEmail() == email.toLowerCase();
      allow list: if false;
      allow write: if false;
    }

    // ─────────────────────────── drivers/{uid} ─────────────────────────────

    match /drivers/{uid} {
      // Roster managed by the `createDriver`/`setDriverActive`/`deleteDriver`
      // Cloud Functions only. Admins read the roster for assignment; drivers
      // read their own document.
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────── settings/app ──────────────────────────────

    match /settings/{settingId} {
      allow get, list: if true; // delivery fee is public by design
      allow write: if isAdmin()
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryFee <= 500;
    }

    // Everything else is denied by default.
  }
}
